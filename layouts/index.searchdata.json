{{- $posts := slice -}}
{{- range where site.RegularPages "Type" "in" (slice "post" "note") -}}
  {{- $content := .Content | replaceRE `(?s)<pre[^>]*>.*?</pre>` " " -}}
  {{- $headings := slice -}}
  {{- range findRE `(?s)<h[23][^>]*>.*?</h[23]>` $content -}}
    {{- $headings = $headings | append (. | plainify | htmlUnescape | strings.TrimSpace) -}}
  {{- end -}}
  {{- $body := $content | plainify | htmlUnescape | replaceRE `\s+` " " | strings.TrimSpace -}}
  {{- $posts = $posts | append (dict
    "title" .Title
    "url" .RelPermalink
    "date" (.Date.Format "2006-01-02")
    "tags" (.Params.tags | default (slice))
    "headings" $headings
    "body" $body
  ) -}}
{{- end -}}
{{- $posts | jsonify -}}
